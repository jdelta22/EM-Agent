POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent

# Caddy: ":80" for local, or a domain for automatic HTTPS
SITE_ADDRESS=:80

ANTHROPIC_API_KEY=
# Optional, defaults to claude-haiku-5-5
# ANTHROPIC_MODEL=

# Shared token that attendants send in the X-Attendant-Token header (attendant endpoints are
# refused while it is empty). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ATTENDANT_TOKEN=
# Seconds without attendant activity before the agent takes the conversation back (default 1800)
# HANDOFF_TIMEOUT_SECONDS=
